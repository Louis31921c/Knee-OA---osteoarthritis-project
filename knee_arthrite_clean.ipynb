      "source": [
        "## 4 — Class weights\n",
        "\n"
      ],
      "id": "O8nREDGepuOz"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "cVpp3DzMpuO0",
        "outputId": "b49f7b08-5145-428b-f691-d118151b4045"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Class counts: [2286, 1046, 1516, 757, 173]\n",
            "Computed class weights: [0.047785   0.10443259 0.07205573 0.14430185 0.6314248 ]\n"
          ]
        }
      ],
      "source": [
        "class_counts = Counter(label for _, label in train_rows)\n",
        "\n",
        "num_classes = len(CONFIG[\"class_names\"])\n",
        "counts = [class_counts[i] for i in range(num_classes)]\n",
        "\n",
        "\n",
        "total_samples = sum(counts)\n",
        "weights = [total_samples / (num_classes * count) for count in counts]\n",
        "weights = torch.tensor(weights, dtype=torch.float).to(device)\n",
        "weights = weights / weights.sum()\n",
        "\n",
        "print(\"Class counts:\", counts)\n",
        "print(\"Computed class weights:\", weights.cpu().numpy())"
      ],
      "id": "cVpp3DzMpuO0"
    },
