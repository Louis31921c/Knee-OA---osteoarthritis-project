      "source": [
        "# SPLITTING TEST/ TRAIN/ VAL\n",
        "def list_split(split):\n",
        "    split_dir = os.path.join(CONFIG[\"data_root\"], split)\n",
        "    rows = []\n",
        "    for label_idx, c in enumerate(CONFIG[\"class_names\"]):\n",
        "        for f in glob.glob(os.path.join(split_dir, c, \"*\")):\n",
        "            rows.append((f, label_idx))\n",
        "    return rows\n",
        "\n",
        "train_rows = list_split(\"train\")\n",
        "val_rows = list_split(\"val\")\n",
        "test_rows = list_split(\"test\")\n",
        "print(f\"train: {len(train_rows)} | val: {len(val_rows)} | test: {len(test_rows)} images\")"
      ],
      "id": "7qGaVlRSpuOv"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "s3CPJcvOpuOy"
      },
      "outputs": [],
      "source": [
        "class KneeOADataset(Dataset):\n",
        "    def __init__(self, rows, img_size, augment=False):\n",
        "        self.rows = rows\n",
        "        base = [T.Resize((img_size, img_size))]\n",
        "        if augment:\n",
        "            base += [T.RandomHorizontalFlip(0.5), T.RandomRotation(10)]\n",
        "        base += [T.ToTensor(), T.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])]\n",
        "        self.tf = T.Compose(base)\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.rows)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        filepath, label = self.rows[idx]\n",
        "        img = self.tf(Image.open(filepath).convert(\"RGB\"))\n",
        "        return img, torch.tensor(label, dtype=torch.long)"
      ],
      "id": "s3CPJcvOpuOy"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "mrWCkyVhpuOz"
      },
      "outputs": [],
      "source": [
        "train_ds = KneeOADataset(train_rows, CONFIG[\"img_size\"], augment=True)\n",
        "val_ds = KneeOADataset(val_rows, CONFIG[\"img_size\"], augment=False)\n",
        "\n",
        "train_dl = DataLoader(train_ds, batch_size=CONFIG[\"batch_size\"], shuffle=True)\n",
        "val_dl = DataLoader(val_ds, batch_size=CONFIG[\"batch_size\"], shuffle=False)"
      ],
      "id": "mrWCkyVhpuOz"
