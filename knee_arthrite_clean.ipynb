        "from sklearn.metrics import roc_curve, auc\n",
        "from sklearn.preprocessing import label_binarize\n",
        "import numpy as np\n",
        "\n",
        "# how well does the model recognizes each grade from each other\n",
        "# any curve above AUC = .50 means the model is able to tell each image appart\n",
        "\n",
        "# NOTE : the model scores very high for grade 4 because of the scarcity of data in this grade,\n",
        "# Grade 4 represents only 3% of the whole train set\n",
        "all_probs = []\n",
        "model.eval()\n",
        "with torch.no_grad():\n",
        "    for imgs, labels in test_dl:\n",
        "        imgs = imgs.to(device)\n",
        "        probs = torch.softmax(model(imgs), dim=1)\n",
        "        all_probs.extend(probs.cpu().numpy())\n",
        "all_probs = np.array(all_probs)\n",
        "\n",
        "y_true_bin = label_binarize(all_labels, classes=range(len(CONFIG[\"class_names\"])))\n",
        "\n",
        "plt.figure(figsize=(7, 6))\n",
        "for i, grade in enumerate(CONFIG[\"class_names\"]):\n",
        "    fpr, tpr, _ = roc_curve(y_true_bin[:, i], all_probs[:, i])\n",
        "    roc_auc = auc(fpr, tpr)\n",
